#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    bool flag = true;
    int n, cont=2, gen=0;
    cout << "Ingrese un numero: ";
    cin >> n;
    while (gen<n)
    {
        flag = true;
        for (int i = 2; i <= sqrt(cont); i++)
            if (cont % i == 0) {
                flag = false;
                break;
            }

        if (flag) {
            cout << cont << ",";
            gen++;
        }
        cont++;
    }
    return 0;
}
