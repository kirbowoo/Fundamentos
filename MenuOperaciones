#include <iostream>
using namespace std;
int main()
{
  float a,b,r;
  int op;
  
  cout<<"Ingresa el primer valor: ";
  cin>>a;
  cout<<"Ingresa el segundo valor: ";
  cin>>b;
  cout<<"   Menu"<<endl;
  cout<< "1. Suma"<< endl;
  cout<< "2. Resta" << endl;
  cout<< "3. Producto" << endl;
  cout<< "4. División" << endl;
  cout<< "0. Salir" << endl;
  cout<< "Elige una opción: ";
  cin >> op;
  
  switch (op)
  {
      case 1:
        r=a+b;
      break;
      case 2:
        r=a-b;
      break;
      case 3:
        r=a*b;
      break;
      case 4:
        r=a/b;
      break;
      case 0:
        cout<<"Salir"<<endl;
        return 0;
      break;
    default:
        cout<<"Error"<<endl;
        return 0;
  }
  
 cout<<"El resultado es: "<<r;
    return 0;
}
