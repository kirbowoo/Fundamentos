#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float a,b,c;
    double x1,x2,D,s1;
    cout<<"Ingresa el valor de a: ";
    cin>>a;
    if (a==0){ 
        cout<<"No se puede calcular entre 0, cambia el valor de a.";
        return 0;
    }
        else {
            cout<<"Ingresa el valor de b: ";
            cin>>b;
            cout<<"Ingresa el valor de c: ";
            cin>>c;
            D=b*b-4*a*c;
        }
            if (D==0){
                s1=(-b)/(2*a);
                cout<<"La unica solucion es: "<<s1;
                return 0;
            }
            else 
                if (D>0){
                    
        
                    x1=(-b+sqrt(b*b-4*a*c))/(2*a);
                    x2=(-b-sqrt(b*b-4*a*c))/(2*a);
                    cout<<"El valor de la raiz x1 es: "<<x1<<endl;
                    cout<<"El valor de la raiz x2 es: "<<x2;
                }
                else {
                    x1=(-b)/(2*a);
                    x2=sqrt(-D)/(2*a);
                    cout<<"El valor de la primer raiz x1 es: "<<x1<<"+"<<x2<<"i"<<endl;
                    cout<<"El valor de la primer raiz x2 es: "<<x1<<"-"<<x2<<"i";
                }

    return 0;
}
