#include <iostream>
#include <cmath>

using namespace std;

int main() {
    double x1, y1, x2, y2, x3, y3;

    cout << "Ingrese X e Y del primer punto (P1): ";
    cin >> x1 >> y1;

    cout << "Ingrese X e Y del segundo punto (P2): ";
    cin >> x2 >> y2;

    cout << "Ingrese X e Y del tercer punto (P3): ";
    cin >> x3 >> y3;

    double D = 2 * (x1 * (y2 - y3) + x2 * (y3 - y1) + x3 * (y1 - y2));

    if (D == 0) {
        cout << "Los puntos son colineales; no se puede formar una circunferencia.\n";
        return 0;
    }

    double ux = ((x1 * x1 + y1 * y1) * (y2 - y3) + 
                 (x2 * x2 + y2 * y2) * (y3 - y1) + 
                 (x3 * x3 + y3 * y3) * (y1 - y2)) / D;

    double uy = ((x1 * x1 + y1 * y1) * (x3 - x2) + 
                 (x2 * x2 + y2 * y2) * (x1 - x3) + 
                 (x3 * x3 + y3 * y3) * (x2 - x1)) / D;

    double r = sqrt((ux - x1) * (ux - x1) + (uy - y1) * (uy - y1));

    cout << "\nCentro: (" << ux << ", " << uy << ")\n";
    cout << "Radio: " << r << "\n";

    return 0;
}
