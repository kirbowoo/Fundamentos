#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    float a,b,c;
    double x1,x2;
    cout<<"Ingresa el valor de a: ";
    cin>>a;
    cout<<"Ingresa el valor de b: ";
    cin>>b;
    cout<<"Ingresa el valor de c: ";
    cin>>c;
    x1=(-b+sqrt(b*b-4*a*c))/(2*a);
    x2=(-b-sqrt(b*b-4*a*c))/(2*a);
    cout<<"El valor de la raiz x1 es: "<<x1<<endl;
    cout<<"El valor de la raiz x2 es: "<<x2;

    return 0;
}
