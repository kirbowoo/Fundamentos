#include <iostream>
#include <cmath>
using namespace std;
int main()
{
    double d;
    float x1,y1,x2,y2;
    cout<<"Ingresa x1: ";
    cin>>x1;
    cout<<"Ingresa y1: ";
    cin>>y1;
    cout<<"Ingresa x2: ";
    cin>>x2;
    cout<<"Ingresa y2: ";
    cin>>y2;
    d=sqrt(pow((x2-x1),2)+pow((y2-y1),2));
    cout<<"La distancia entre los dos puntos es: "<<d;
    return 0;
}
