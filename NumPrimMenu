#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    int op;
    cout << "Elija la opcion: " << endl;
    cout << "1. Numeros primos" << endl;
    cout << "0. Salir" << endl;
    cout << "Opcion: ";
    cin >> op;

    switch (op) {
    case 1: {
        while (true)
        {
            bool flag = true;
            int n, cont = 2, gen = 0;

            cout << "Ingrese la cantidad de numeros primos: ";
            cin >> n;

            cout << "Los primeros " << n << " numeros primos son: ";
            while (gen < n)
            {
                flag = true;
                for (int i = 2; i <= sqrt(cont); i++) {
                    if (cont % i == 0) {
                        flag = false;
                        break;
                    }
                }

                if (flag) {
                    cout << cont << (gen < n - 1 ? ", " : "");
                    gen++;
                }
                cont++;
            }
            cout << endl;

            int sub_op;
            cout << "¿Que desea hacer?" << endl;
            cout << "1. Volver a ingresar un dato" << endl;
            cout << "0. Salir" << endl;
            cout << "Opcion: ";
            cin >> sub_op;

            if (sub_op == 0) {
                cout << "Saliendo..." << endl;
                return 0;
            }
        }
        break;
    }
    case 0:
        cout << "Saliendo..." << endl;
        return 0;

    default:
        cout << "Opcion no valida." << endl;
        break;
    }

    return 0;
}
